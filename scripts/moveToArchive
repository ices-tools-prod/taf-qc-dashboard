#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
METADATA_DIR="$SCRIPT_DIR/../metadata"
ARCHIVE_DIR="$METADATA_DIR/archive"
REPOS_FILE="/home/davidolsenices/repositories/taf-qc-dashboard/json/repos.json"

mkdir -p "$ARCHIVE_DIR"

jq -r '.[].name' "$REPOS_FILE" | sort > /tmp/current_repos.txt

for dir in "$METADATA_DIR"/*; do
    [[ -d "$dir" ]] || continue

    repo=$(basename "$dir")

    [[ "$repo" == "archive" ]] && continue

    if ! grep -Fxq "$repo" /tmp/current_repos.txt; then
        echo "Archiving: $repo"
        mv "$dir" "$ARCHIVE_DIR/"
    fi
done
