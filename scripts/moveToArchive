#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
METADATA_DIR="$SCRIPT_DIR/../metadata"
ARCHIVE_DIR="$METADATA_DIR/archive"
REPOS_FILE="$SCRIPT_DIR/../json/repos.json"

mkdir -p "$ARCHIVE_DIR"

CURRENT_REPOS=$(mktemp)
trap 'rm -f "$CURRENT_REPOS"' EXIT

jq -r '.[].name' "$REPOS_FILE" | sort > "$CURRENT_REPOS"

for dir in "$METADATA_DIR"/*; do
    [[ -d "$dir" ]] || continue

    repo=$(basename "$dir")

    [[ "$repo" == "archive" ]] && continue

    if ! grep -Fxq "$repo" "$CURRENT_REPOS"; then
        echo "Archiving: $repo"
        mv "$dir" "$ARCHIVE_DIR/"
    fi
done
