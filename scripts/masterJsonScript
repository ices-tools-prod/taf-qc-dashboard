#!/usr/bin/env bash

set -euo pipefail

METADATA_DIR="metadata"
OUTPUT_FILE="master.json"


# Coerce a field to an array: array stays, null becomes [], scalar is wrapped.
JQ_PROGRAM='def as_array: if type == "array" then . elif . == null then [] else [.] end;
  map(. + {
    warning_checks: (.warning_checks | as_array),
    failed_checks: (.failed_checks | as_array),
    passed_checks: (.passed_checks | as_array)
  })'

find "$METADATA_DIR" -type d -name archive -prune -o -type f -name "latest.json" -print0 \
  | xargs -0 -r cat \
  | jq -s "$JQ_PROGRAM" > "$OUTPUT_FILE"

COUNT=$(jq length "$OUTPUT_FILE")

echo "Created $OUTPUT_FILE containing $COUNT repositories"
