#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
METADATA_DIR="${METADATA_DIR:-$SCRIPT_DIR/../metadata}"
OUTPUT_FILE="${OUTPUT_FILE:-$SCRIPT_DIR/../master.json}"

find "$METADATA_DIR" -type d -name archive -prune -o -type f -name "latest.json" -print0 \
  | xargs -0 -r cat \
  | jq -L "$SCRIPT_DIR" -s 'include "metadata"; map(normalize_metadata)' > "$OUTPUT_FILE"

COUNT=$(jq length "$OUTPUT_FILE")

echo "Created $OUTPUT_FILE containing $COUNT repositories"
