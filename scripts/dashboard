#!/usr/bin/env bash

set -euo pipefail

METADATA_DIR="${METADATA_DIR:-metadata}"
README_FILE="${README_FILE:-README.md}"

# Number of failing repositories shown before the collapsed section.
ATTENTION_LIMIT="${ATTENTION_LIMIT:-10}"

# Number of common failed checks shown before the collapsed section.
CHECK_LIMIT="${CHECK_LIMIT:-5}"

TOTAL=0
PASSED=0
FAILED=0
UNKNOWN=0
INVALID=0

LATEST_FILES_FILE=$(mktemp)
FAILED_CHECKS_FILE=$(mktemp)
REPORT_ROWS_FILE=$(mktemp)
ATTENTION_DATA_FILE=$(mktemp)
ATTENTION_SORTED_FILE=$(mktemp)
ATTENTION_PREVIEW_FILE=$(mktemp)
ATTENTION_ALL_FILE=$(mktemp)
FAILED_CHECK_ROWS_FILE=$(mktemp)
FAILED_CHECK_PREVIEW_FILE=$(mktemp)
OUTPUT_FILE=$(mktemp)

cleanup() {
  rm -f \
    "$LATEST_FILES_FILE" \
    "$FAILED_CHECKS_FILE" \
    "$REPORT_ROWS_FILE" \
    "$ATTENTION_DATA_FILE" \
    "$ATTENTION_SORTED_FILE" \
    "$ATTENTION_PREVIEW_FILE" \
    "$ATTENTION_ALL_FILE" \
    "$FAILED_CHECK_ROWS_FILE" \
    "$FAILED_CHECK_PREVIEW_FILE" \
    "$OUTPUT_FILE"
}

trap cleanup EXIT

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Error: required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

markdown_escape() {
  printf '%s' "$1" \
    | tr '\r\n\t' '   ' \
    | sed 's/\\/\\\\/g; s/|/\\|/g'
}

code_escape() {
  printf '%s' "$1" | tr '\r\n`' '   '
}

require_command find
require_command jq
require_command sort
require_command awk
require_command sed
require_command head
require_command tail
require_command uniq
require_command date
require_command mkdir
require_command dirname

if [[ ! "$ATTENTION_LIMIT" =~ ^[0-9]+$ ]]; then
  printf 'Error: ATTENTION_LIMIT must be a non-negative integer.\n' >&2
  exit 1
fi

if [[ ! "$CHECK_LIMIT" =~ ^[0-9]+$ ]]; then
  printf 'Error: CHECK_LIMIT must be a non-negative integer.\n' >&2
  exit 1
fi

if [[ ! -d "$METADATA_DIR" ]]; then
  printf "Error: directory '%s' does not exist.\n" "$METADATA_DIR" >&2
  exit 1
fi

README_DIR=$(dirname "$README_FILE")
mkdir -p "$README_DIR"

printf "Scanning active metadata under '%s'...\n" "$METADATA_DIR"

# Find latest.json recursively, but do not enter archive directories.
find "$METADATA_DIR" \
  -type d -name archive -prune -o \
  -type f -name 'latest.json' -print0 \
  | sort -z > "$LATEST_FILES_FILE"

FOUND=$(awk 'BEGIN { RS = "\0" } END { print NR }' "$LATEST_FILES_FILE")

printf 'Found %s active latest.json files.\n' "$FOUND"

while IFS= read -r -d '' json; do
  printf 'Processing: %s\n' "$json"

  if ! jq empty "$json" >/dev/null 2>&1; then
    printf 'Warning: invalid JSON skipped: %s\n' "$json" >&2
    INVALID=$((INVALID + 1))
    continue
  fi

  TOTAL=$((TOTAL + 1))

  REPOSITORY=$(jq -r '
    .repository // "unknown-repository"
    | tostring
  ' "$json")

  TIMESTAMP=$(jq -r '
    .timestamp // "unknown"
    | tostring
  ' "$json")

  TAF_VERSION=$(jq -r '
    .taf_version // "unknown"
    | tostring
  ' "$json")

  QCTAF_VERSION=$(jq -r '
    .qctaf_version // "unknown"
    | tostring
  ' "$json")

  GITHUB_SHA=$(jq -r '
    .github_sha // "unknown"
    | tostring
  ' "$json")

  PASSED_VALUE=$(jq -r '
    if .passed == true then
      "true"
    elif .passed == false then
      "false"
    else
      "unknown"
    end
  ' "$json")

  FAILED_COUNT=$(jq '
    if (.failed_checks | type) == "array" then
      [.failed_checks[] | tostring]
      | unique
      | length
    else
      0
    end
  ' "$json")

  FAILED_CHECKS=$(jq -r '
    if (.failed_checks | type) == "array"
       and (.failed_checks | length) > 0
    then
      [.failed_checks[] | tostring]
      | unique
      | map("`" + gsub("`"; "") + "`")
      | join("<br>")
    else
      "None"
    end
  ' "$json")

  # Count each check at most once per repository.
  jq -r '
    if (.failed_checks | type) == "array" then
      [.failed_checks[] | tostring]
      | unique[]
    else
      empty
    end
  ' "$json" >> "$FAILED_CHECKS_FILE"

  REPOSITORY=$(markdown_escape "$REPOSITORY")
  TIMESTAMP=$(markdown_escape "$TIMESTAMP")
  TAF_VERSION=$(markdown_escape "$TAF_VERSION")
  QCTAF_VERSION=$(markdown_escape "$QCTAF_VERSION")
  GITHUB_SHA=$(code_escape "$GITHUB_SHA")

  if [[ "$GITHUB_SHA" != "unknown" && -n "$GITHUB_SHA" ]]; then
    SHORT_SHA=${GITHUB_SHA:0:7}
  else
    SHORT_SHA="unknown"
  fi

  case "$PASSED_VALUE" in
    true)
      PASSED=$((PASSED + 1))
      STATUS="✅ Passed"
      ;;

    false)
      FAILED=$((FAILED + 1))
      STATUS="❌ Failed"

      # Tab-separated temporary data:
      # failed count, repository, checks, timestamp.
      printf '%s\t%s\t%s\t%s\n' \
        "$FAILED_COUNT" \
        "$REPOSITORY" \
        "$FAILED_CHECKS" \
        "$TIMESTAMP" \
        >> "$ATTENTION_DATA_FILE"
      ;;

    *)
      UNKNOWN=$((UNKNOWN + 1))
      STATUS="⚠️ Unknown"

      printf '%s\t%s\t%s\t%s\n' \
        "$FAILED_COUNT" \
        "$REPOSITORY" \
        'Missing or invalid `passed` status' \
        "$TIMESTAMP" \
        >> "$ATTENTION_DATA_FILE"
      ;;
  esac

  printf '| %s | %s | %s | %s | %s | %s | `%s` |\n' \
    "$STATUS" \
    "$REPOSITORY" \
    "$FAILED_COUNT" \
    "$TAF_VERSION" \
    "$QCTAF_VERSION" \
    "$TIMESTAMP" \
    "$SHORT_SHA" \
    >> "$REPORT_ROWS_FILE"

done < "$LATEST_FILES_FILE"

PASS_RATE=$(awk \
  -v passed="$PASSED" \
  -v total="$TOTAL" '
    BEGIN {
      if (total == 0) {
        printf "0.0"
      } else {
        printf "%.1f", (passed / total) * 100
      }
    }
  ')

PASS_RATE_INTEGER=$(awk \
  -v rate="$PASS_RATE" '
    BEGIN {
      printf "%d", rate + 0.5
    }
  ')

if ((PASS_RATE_INTEGER >= 90)); then
  PASS_RATE_COLOR="brightgreen"
elif ((PASS_RATE_INTEGER >= 70)); then
  PASS_RATE_COLOR="yellow"
else
  PASS_RATE_COLOR="red"
fi

PROGRESS_WIDTH=20
FILLED=$((PASS_RATE_INTEGER * PROGRESS_WIDTH / 100))

if ((FILLED > PROGRESS_WIDTH)); then
  FILLED=$PROGRESS_WIDTH
fi

if ((FILLED < 0)); then
  FILLED=0
fi

EMPTY=$((PROGRESS_WIDTH - FILLED))

printf -v PROGRESS_BAR '%*s' "$FILLED" ''
PROGRESS_BAR=${PROGRESS_BAR// /█}

printf -v EMPTY_BAR '%*s' "$EMPTY" ''
PROGRESS_BAR+=${EMPTY_BAR// /░}

#
# Build the attention tables.
#

if [[ -s "$ATTENTION_DATA_FILE" ]]; then
  # Sort numerically by failed-check count, highest first.
  sort -t $'\t' -k1,1nr -k2,2 "$ATTENTION_DATA_FILE" \
    > "$ATTENTION_SORTED_FILE"

  while IFS=$'\t' read -r count repository checks timestamp; do
    [[ -n "${repository:-}" ]] || continue

    # Compact preview without the long details column.
    printf '| %s | %s | %s |\n' \
      "$repository" \
      "$count" \
      "$timestamp" \
      >> "$ATTENTION_PREVIEW_FILE"

    # Complete hidden table with check details.
    printf '| %s | %s | %s | %s |\n' \
      "$repository" \
      "$count" \
      "$checks" \
      "$timestamp" \
      >> "$ATTENTION_ALL_FILE"

  done < "$ATTENTION_SORTED_FILE"
fi

if [[ ! -s "$ATTENTION_PREVIEW_FILE" ]]; then
  printf '| 🎉 None | 0 | N/A |\n' > "$ATTENTION_PREVIEW_FILE"
else
  head -n "$ATTENTION_LIMIT" \
    "$ATTENTION_PREVIEW_FILE" \
    > "${ATTENTION_PREVIEW_FILE}.limited"

  mv "${ATTENTION_PREVIEW_FILE}.limited" "$ATTENTION_PREVIEW_FILE"
fi

if [[ ! -s "$ATTENTION_ALL_FILE" ]]; then
  printf '| 🎉 None | 0 | No repositories require attention | N/A |\n' \
    > "$ATTENTION_ALL_FILE"
fi

#
# Build failed-check frequency tables.
#

if [[ -s "$FAILED_CHECKS_FILE" ]]; then
  while read -r count check; do
    [[ -n "${check:-}" ]] || continue

    check=$(markdown_escape "$check")

    printf '| `%s` | %s |\n' \
      "$check" \
      "$count" \
      >> "$FAILED_CHECK_ROWS_FILE"

  done < <(
    LC_ALL=C sort "$FAILED_CHECKS_FILE" \
      | uniq -c \
      | sort -k1,1nr -k2,2 \
      | sed -E 's/^[[:space:]]+//'
  )
fi

if [[ ! -s "$FAILED_CHECK_ROWS_FILE" ]]; then
  printf '| None | 0 |\n' > "$FAILED_CHECK_ROWS_FILE"
fi

head -n "$CHECK_LIMIT" \
  "$FAILED_CHECK_ROWS_FILE" \
  > "$FAILED_CHECK_PREVIEW_FILE"

if [[ ! -s "$REPORT_ROWS_FILE" ]]; then
  printf '| ℹ️ No data | No valid repositories found | 0 | unknown | unknown | unknown | `unknown` |\n' \
    > "$REPORT_ROWS_FILE"
fi

ATTENTION_TOTAL=$((FAILED + UNKNOWN))
ATTENTION_PREVIEW_COUNT=$ATTENTION_TOTAL

if ((ATTENTION_PREVIEW_COUNT > ATTENTION_LIMIT)); then
  ATTENTION_PREVIEW_COUNT=$ATTENTION_LIMIT
fi

FAILED_CHECK_TYPE_COUNT=$(wc -l < "$FAILED_CHECK_ROWS_FILE")
FAILED_CHECK_TYPE_COUNT=${FAILED_CHECK_TYPE_COUNT//[[:space:]]/}

if ((FAILED_CHECK_TYPE_COUNT == 1)) &&
   grep -q '^| None | 0 |$' "$FAILED_CHECK_ROWS_FILE"; then
  FAILED_CHECK_TYPE_COUNT=0
fi

CHECK_PREVIEW_COUNT=$FAILED_CHECK_TYPE_COUNT

if ((CHECK_PREVIEW_COUNT > CHECK_LIMIT)); then
  CHECK_PREVIEW_COUNT=$CHECK_LIMIT
fi

GENERATED_AT=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

cat > "$OUTPUT_FILE" <<EOF
# TAF QC Dashboard

> Automatically generated from active repository metadata under \`${METADATA_DIR}/\`. Archived metadata is excluded.

https://img.shields.io/badge/repositories-${TOTAL}-blue
https://img.shields.io/badge/passed-${PASSED}-brightgreen
https://img.shields.io/badge/failed-${FAILED}-red
https://img.shields.io/badge/unknown-${UNKNOWN}-orange
https://img.shields.io/badge/pass%20rate-${PASS_RATE}%25-${PASS_RATE_COLOR}

## Overall status

### ${PASS_RATE}% passing

\`${PROGRESS_BAR}\`

**${PASSED} of ${TOTAL} repositories passed QC validation.**

| 📦 Processed repositories | ✅ Passed | ❌ Failed | ⚠️ Unknown | 🛑 Invalid metadata |
|--------------------------:|----------:|----------:|-----------:|--------------------:|
| **${TOTAL}** | **${PASSED}** | **${FAILED}** | **${UNKNOWN}** | **${INVALID}** |

## Repositories requiring attention

**${ATTENTION_TOTAL} repositories currently require attention.**

Showing up to ${ATTENTION_PREVIEW_COUNT} repositories, ordered by number of failed checks.

| Repository | Failed checks | Last validation |
|:-----------|--------------:|:----------------|
EOF

cat "$ATTENTION_PREVIEW_FILE" >> "$OUTPUT_FILE"

cat >> "$OUTPUT_FILE" <<EOF

<details>
<summary><strong>View all ${ATTENTION_TOTAL} repositories requiring attention</strong></summary>

<br>

| Repository | Failed checks | Details | Last validation |
|:-----------|--------------:|:--------|:----------------|
EOF

cat "$ATTENTION_ALL_FILE" >> "$OUTPUT_FILE"

cat >> "$OUTPUT_FILE" <<EOF

</details>

## Most common failed checks

Showing up to ${CHECK_PREVIEW_COUNT} of ${FAILED_CHECK_TYPE_COUNT} failed check types.

| QC check | Affected repositories |
|:---------|----------------------:|
EOF

cat "$FAILED_CHECK_PREVIEW_FILE" >> "$OUTPUT_FILE"

cat >> "$OUTPUT_FILE" <<EOF

<details>
<summary><strong>View all ${FAILED_CHECK_TYPE_COUNT} failed check types</strong></summary>

<br>

| QC check | Affected repositories |
|:---------|----------------------:|
EOF

cat "$FAILED_CHECK_ROWS_FILE" >> "$OUTPUT_FILE"

cat >> "$OUTPUT_FILE" <<EOF

</details>

## Complete repository results

<details>
<summary><strong>View all ${TOTAL} repository results</strong></summary>

<br>

| Status | Repository | Failed checks | TAF | qcTAF | Last validation | Commit |
|:-------|:-----------|--------------:|:----|:------|:----------------|:-------|
EOF

cat "$REPORT_ROWS_FILE" >> "$OUTPUT_FILE"

cat >> "$OUTPUT_FILE" <<EOF

</details>

---

_Last generated at ${GENERATED_AT} from ${TOTAL} valid active metadata files. ${INVALID} invalid files were skipped._
EOF

# Replace README only after the complete dashboard has been generated.
mv "$OUTPUT_FILE" "$README_FILE"

printf '\nDashboard written to %s\n' "$README_FILE"
printf 'Discovered active metadata files: %s\n' "$FOUND"
printf 'Valid metadata: %s\n' "$TOTAL"
printf 'Passed: %s\n' "$PASSED"
printf 'Failed: %s\n' "$FAILED"
printf 'Unknown: %s\n' "$UNKNOWN"
printf 'Invalid metadata: %s\n' "$INVALID"
printf 'Pass rate: %s%%\n' "$PASS_RATE"
printf 'Attention preview limit: %s\n' "$ATTENTION_LIMIT"
printf 'Failed-check preview limit: %s\n' "$CHECK_LIMIT"
