#!/usr/bin/env bash
# Keep only the newest KEEP timestamped metadata files per repository.
# latest.json and metadata/archive are never touched.
# Usage: KEEP=10 scripts/pruneHistory [--dry-run]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
METADATA_DIR="${METADATA_DIR:-$SCRIPT_DIR/../metadata}"
KEEP="${KEEP:-10}"
DRY_RUN=false
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=true

if [[ ! "$KEEP" =~ ^[0-9]+$ ]]; then
  echo "Error: KEEP must be a non-negative integer." >&2
  exit 1
fi

removed=0
for dir in "$METADATA_DIR"/*/; do
  [[ -d "$dir" ]] || continue
  [[ "$(basename "$dir")" == "archive" ]] && continue

  # Timestamped names sort chronologically; newest first, skip the first KEEP.
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    if $DRY_RUN; then echo "Would remove: $file"; else rm -f -- "$file"; fi
    removed=$((removed + 1))
  done < <(find "$dir" -maxdepth 1 -type f -name '*.json' ! -name 'latest.json' | LC_ALL=C sort -r | tail -n +"$((10#$KEEP + 1))")
done

if $DRY_RUN; then echo "Files that would be removed: $removed"; else echo "Files removed: $removed"; fi
