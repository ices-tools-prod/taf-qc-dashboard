#!/usr/bin/env bash

set -euo pipefail

TOTAL=0
PASSED=0
FAILED=0

REPORT_ROWS=""
FAILED_CHECKS_FILE=$(mktemp)

echo "Scanning metadata..."

FOUND=$(find metadata -type f -name latest.json | wc -l)

echo "Found $FOUND latest.json files"

while IFS= read -r json
do
    [ -f "$json" ] || continue

    TOTAL=$((TOTAL + 1))

    REPO=$(jq -r '.repository' "$json")
    PASS=$(jq -r '.passed' "$json")
    TIMESTAMP=$(jq -r '.timestamp' "$json")

    FAILED_COUNT=$(jq '.failed_checks | length' "$json")

    jq -r '.failed_checks[]?' "$json" >> "$FAILED_CHECKS_FILE"

    if [ "$PASS" = "true" ]; then
        PASSED=$((PASSED + 1))
        STATUS="✅"
    else
        FAILED=$((FAILED + 1))
        STATUS="❌"
    fi

    REPORT_ROWS="${REPORT_ROWS}
| ${STATUS} | ${REPO} | ${FAILED_COUNT} | ${TIMESTAMP} |"

done < <(find metadata -type f -name latest.json | sort)

PASS_RATE=0

if [ "$TOTAL" -gt 0 ]; then
    PASS_RATE=$(( PASSED * 100 / TOTAL ))
fi

TOP_FAILED_CHECKS=""

if [ -s "$FAILED_CHECKS_FILE" ]; then
    while read -r count check
    do
        TOP_FAILED_CHECKS="${TOP_FAILED_CHECKS}
| ${check} | ${count} |"
    done < <(
        sort "$FAILED_CHECKS_FILE" |
        uniq -c |
        sort -nr
    )
fi

cat > README.md <<EOF
# QC Dashboard

Automatically generated from repository metadata.

## Summary

| Metric | Count |
|---------|---------|
| Repositories | $TOTAL |
| Passed | $PASSED |
| Failed | $FAILED |

Pass rate: ${PASS_RATE}%

## Repository Status

| Status | Repository | Failed Checks | Last Run |
|---------|---------|---------|---------|
$REPORT_ROWS

## Most Common Failed Checks

| Check | Count |
|---------|---------|
$TOP_FAILED_CHECKS

EOF

rm -f "$FAILED_CHECKS_FILE"

echo "Dashboard written to README.md"
